@model ClaimManagementsystem.Models.Claim

@{
    ViewData["Title"] = "Reject Claim";
}

<link rel="stylesheet" href="~/css/claims.css" />

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0"><i class="fas fa-times-circle"></i> Reject Claim #@Model.Id</h3>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="claim-card mb-4">
                        <h5 class="mb-3">Claim Details</h5>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <strong>Claim Type:</strong> @Model.ClaimType
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Lecturer:</strong> @Model.LecturerName
                            </div>
                            <div class="col-md-12 mb-2">
                                <strong>Description:</strong><br />
                                @Model.Description
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Hours Worked:</strong> @Model.HoursWorked
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Hourly Rate:</strong> R @Model.HourlyRate.ToString("N2")
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Total Amount:</strong> <span class="text-success fw-bold">R @Model.TotalAmount.ToString("N2")</span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Date Submitted:</strong> @Model.DateSubmitted.ToString("yyyy-MM-dd")
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-exclamation-triangle"></i> <strong>Warning:</strong> You are about to reject this claim. Please provide a clear reason for the rejection.
                    </div>

                    <form asp-action="RejectClaim" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label for="rejectionReason" class="form-label">
                                Rejection Reason <span class="text-danger">*</span>
                            </label>
                            <textarea 
                                name="rejectionReason" 
                                id="rejectionReason" 
                                class="form-control" 
                                rows="5" 
                                placeholder="Please provide a detailed reason for rejecting this claim..."
                                required></textarea>
                            <div class="form-text">This reason will be visible to the claim submitter.</div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="ViewClaims" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-times"></i> Confirm Rejection
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
}
