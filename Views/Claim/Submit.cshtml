@model ClaimManagementsystem.Models.Claim

@{
    ViewData["Title"] = "Submit Claim";
}

<link rel="stylesheet" href="~/css/claims.css" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="fas fa-file-invoice-dollar"></i> Submit New Claim</h3>
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Submit" method="post" id="claimForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-section">
                            <h5 class="form-section-title">Claim Information</h5>
                            
                            <div class="mb-3">
                                <label asp-for="ClaimType" class="form-label">Claim Type <span class="text-danger">*</span></label>
                                <input asp-for="ClaimType" class="form-control" id="ClaimType" placeholder="e.g., Lecture, Tutorial, Marking" />
                                <span asp-validation-for="ClaimType" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">Description <span class="text-danger">*</span></label>
                                <textarea asp-for="Description" class="form-control" id="Description" rows="4" placeholder="Provide detailed description of your claim (minimum 10 characters)"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="LecturerId" class="form-label">Lecturer <span class="text-danger">*</span></label>
                                <select asp-for="LecturerId" class="form-select" id="LecturerId">
                                    <option value="">-- Select Lecturer --</option>
                                    @if (ViewBag.Lecturers != null)
                                    {
                                        @foreach (var lecturer in ViewBag.Lecturers)
                                        {
                                            <option value="@lecturer.Id">@lecturer.LecturerName</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="LecturerId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-section">
                            <h5 class="form-section-title">Calculation Details</h5>
                            
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="HoursWorked" class="form-label">
                                        Hours Worked <span class="text-danger">*</span>
                                        <i class="fas fa-info-circle tooltip-icon" title="Enter the number of hours worked (0-1000)"></i>
                                    </label>
                                    <input asp-for="HoursWorked" type="number" step="0.01" class="form-control" id="HoursWorked" placeholder="0.00" />
                                    <span asp-validation-for="HoursWorked" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="HourlyRate" class="form-label">
                                        Hourly Rate (R) <span class="text-danger">*</span>
                                        <i class="fas fa-info-circle tooltip-icon" title="Enter your hourly rate (0-10000)"></i>
                                    </label>
                                    <input asp-for="HourlyRate" type="number" step="0.01" class="form-control" id="HourlyRate" placeholder="0.00" />
                                    <span asp-validation-for="HourlyRate" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="total-amount-display">
                                <div class="total-amount-label">Total Claim Amount</div>
                                <div class="total-amount-value" id="totalAmountDisplay">R 0.00</div>
                                <input asp-for="TotalAmount" type="hidden" id="TotalAmount" />
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg" id="submitClaimBtn" disabled>
                                <i class="fas fa-paper-plane"></i> Submit Claim
                            </button>
                            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/claim.js"></script>
}
