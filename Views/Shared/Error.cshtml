@{
    ViewData["Title"] = "Error";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card mt-5">
                <div class="card-header bg-danger text-white">
                    <h2 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Error</h2>
                </div>
                <div class="card-body text-center py-5">
                    <i class="fas fa-bug fa-5x text-danger mb-4"></i>
                    <h3 class="text-danger mb-3">An error occurred while processing your request.</h3>
                    <p class="text-muted mb-4">
                        We apologize for the inconvenience. Please try again later or contact support if the problem persists.
                    </p>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a href="/" class="btn btn-emerald me-md-2">
                            <i class="fas fa-home me-2"></i>Go Home
                        </a>
                        <a href="/Home/Contact" class="btn btn-outline-emerald">
                            <i class="fas fa-envelope me-2"></i>Contact Support
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
