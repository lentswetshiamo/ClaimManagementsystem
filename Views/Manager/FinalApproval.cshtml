@model List<ClaimManagementsystem.Models.Claim>
@{
    ViewData["Title"] = "Final Approval";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0"><i class="fas fa-check-double me-2 text-emerald"></i>Final Approval</h1>
                <a href="/Manager/Dashboard" class="btn btn-outline-emerald">
                    <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                </a>
            </div>
            <p class="text-muted">Final review and approval of coordinator-approved claims</p>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-clipboard-check me-2 text-warning"></i>Claims for Final Approval</h5>
                    <span class="badge bg-warning">@Model.Count claims</span>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Claim ID</th>
                                        <th>Lecturer</th>
                                        <th>Coordinator</th>
                                        <th>Period</th>
                                        <th>Amount</th>
                                        <th>Coordinator Comments</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var claim in Model)
                                    {
                                        <tr>
                                            <td><strong>#@claim.ClaimId</strong></td>
                                            <td>@claim.UserName</td>
                                            <td>Prof. Sarah Johnson</td>
                                            <td>@claim.Month @claim.Year</td>
                                            <td><strong>R @claim.TotalAmount.ToString("N2")</strong></td>
                                            <td>
                                                <small class="text-muted">"@claim.Comments"</small>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-success" onclick="approveClaim(@claim.ClaimId)">
                                                        <i class="fas fa-check me-1"></i>Approve
                                                    </button>
                                                    <button class="btn btn-outline-danger" onclick="rejectClaim(@claim.ClaimId)">
                                                        <i class="fas fa-times me-1"></i>Reject
                                                    </button>
                                                    <a href="/Manager/ClaimDetails/@claim.ClaimId" class="btn btn-outline-emerald">
                                                        <i class="fas fa-search me-1"></i>Details
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                            <h4 class="text-success">All Caught Up!</h4>
                            <p class="text-muted mb-4">There are no claims awaiting final approval.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function approveClaim(claimId) {
            if (confirm('Are you sure you want to approve this claim?')) {
                // Simulate API call
                showNotification('Claim approved successfully', 'success');
                setTimeout(() => {
                    window.location.reload();
                }, 1500);
            }
        }

        function rejectClaim(claimId) {
            const comments = prompt('Please provide reason for rejection:');
            if (comments !== null) {
                // Simulate API call
                showNotification('Claim rejected', 'warning');
                setTimeout(() => {
                    window.location.reload();
                }, 1500);
            }
        }
    </script>
}
