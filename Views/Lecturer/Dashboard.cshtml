 @model ClaimManagementsystem.Models.LecturerDashboard

@{
    ViewData["Title"] = "Lecturer Dashboard";
}

<div class="container-fluid">
    <!-- Welcome Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-emerald-light">
                <div class="card-body py-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h1 class="h3 mb-1">Welcome, @Model.UserName!</h1>
                            <p class="mb-0 text-emerald">Contract Lecturer Dashboard</p>
                        </div>
                        <div class="col-md-4 text-end">
                            <a href="/Lecturer/SubmitClaim" class="btn btn-emerald btn-lg">
                                <i class="fas fa-plus-circle me-2"></i>Submit New Claim
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h4 class="mb-0">@Model.PendingClaims.Count</h4>
                            <p class="text-muted mb-0">Pending Claims</p>
                        </div>
                        <div class="flex-shrink-0">
                            <div class="widget-icon">
                                <i class="fas fa-clock"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card dashboard-card approved">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h4 class="mb-0">@Model.ApprovedClaims.Count</h4>
                            <p class="text-muted mb-0">Approved Claims</p>
                        </div>
                        <div class="flex-shrink-0">
                            <div class="widget-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card dashboard-card rejected">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h4 class="mb-0">@Model.RejectedClaims.Count</h4>
                            <p class="text-muted mb-0">Rejected Claims</p>
                        </div>
                        <div class="flex-shrink-0">
                            <div class="widget-icon">
                                <i class="fas fa-times-circle"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card dashboard-card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h4 class="mb-0">R @(Model.ApprovedClaims.Sum(c => c.TotalAmount).ToString("N2"))</h4>
                            <p class="text-muted mb-0">Total Approved</p>
                        </div>
                        <div class="flex-shrink-0">
                            <div class="widget-icon">
                                <i class="fas fa-money-bill-wave"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Pending Claims -->
        <div class="col-lg-6 mb-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-clock me-2 text-warning"></i>Pending Claims</h5>
                    <span class="badge bg-warning">@Model.PendingClaims.Count</span>
                </div>
                <div class="card-body">
                    @if (Model.PendingClaims.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Month</th>
                                        <th>Submitted</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var claim in Model.PendingClaims)
                                    {
                                        <tr>
                                            <td>@claim.Month @claim.Year</td>
                                            <td>@claim.SubmittedDate.ToString("dd MMM yyyy")</td>
                                            <td>R @claim.TotalAmount.ToString("N2")</td>
                                            <td><span class="badge badge-submitted">@claim.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No pending claims</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="col-lg-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-history me-2 text-emerald"></i>Recent Activity</h5>
                </div>
                <div class="card-body">
                    <div class="activity-feed">
                        <div class="activity-item">
                            <div class="activity-icon">
                                <i class="fas fa-file-upload"></i>
                            </div>
                            <div class="activity-content">
                                <div class="activity-title">Claim Submitted</div>
                                <div class="activity-desc">September 2024 claim submitted for review</div>
                                <div class="activity-time">2 hours ago</div>
                            </div>
                        </div>
                        <div class="activity-item">
                            <div class="activity-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="activity-content">
                                <div class="activity-title">Claim Approved</div>
                                <div class="activity-desc">August 2024 claim approved by coordinator</div>
                                <div class="activity-time">1 day ago</div>
                            </div>
                        </div>
                        <div class="activity-item">
                            <div class="activity-icon">
                                <i class="fas fa-user-check"></i>
                            </div>
                            <div class="activity-content">
                                <div class="activity-title">Profile Updated</div>
                                <div class="activity-desc">Banking details updated successfully</div>
                                <div class="activity-time">2 days ago</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-rocket me-2 text-emerald"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3 col-6">
                            <a href="/Lecturer/SubmitClaim" class="btn btn-outline-emerald w-100 h-100 py-3">
                                <i class="fas fa-plus-circle fa-2x mb-2"></i><br>
                                Submit Claim
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="/Lecturer/ClaimHistory" class="btn btn-outline-emerald w-100 h-100 py-3">
                                <i class="fas fa-history fa-2x mb-2"></i><br>
                                Claim History
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="#" class="btn btn-outline-emerald w-100 h-100 py-3">
                                <i class="fas fa-download fa-2x mb-2"></i><br>
                                Export Data
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="#" class="btn btn-outline-emerald w-100 h-100 py-3">
                                <i class="fas fa-question-circle fa-2x mb-2"></i><br>
                                Get Help
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>}
}
