{
    "ConnectionStrings": {
        "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=CaimManagementSystem;Trusted_Connection=true;MultipleActiveResultSets=true"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "CaimManagementSystem": "Information"
        }
    },
    "AllowedHosts": "*",
    "ApplicationSettings": {
        "AppName": "Caim Management System",
        "Version": "2.1.0",
        "Environment": "Development",
        "MaxFileUploadSize": 10485760,
        "AllowedFileTypes": [ ".pdf", ".doc", ".docx", ".jpg", ".jpeg", ".png" ],
        "SessionTimeout": 30,
        "EmailSettings": {
            "SmtpServer": "smtp.university.ac.za",
            "Port": 587,
            "EnableSsl": true,
            "FromEmail": "noreply@university.ac.za"
        }
    },
    "JwtSettings": {
        "SecretKey": "YourSuperSecretKeyHereForCaimManagementSystem2024",
        "Issuer": "CaimManagementSystem",
        "Audience": "CaimManagementSystemUsers",
        "ExpiryMinutes": 60
    }
}
